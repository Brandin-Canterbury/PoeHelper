<Window x:Class="PoeHelper.App.Overlay.CompareOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PoeHelper gear compare" Width="440" SizeToContent="Height" MaxHeight="900"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False">
    <Window.Resources>
        <ResourceDictionary Source="Theme.xaml" />
    </Window.Resources>
    <Border Background="{StaticResource PanelBg}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="4" Padding="12"
            TextElement.Foreground="{StaticResource Text}" TextElement.FontFamily="Segoe UI" TextElement.FontSize="13"
            MouseLeftButtonDown="OnDrag">
        <DockPanel>
            <!-- Header -->
            <DockPanel DockPanel.Dock="Top">
                <Button DockPanel.Dock="Right" Content="✕" Style="{StaticResource FlatButton}" Padding="6,0" VerticalAlignment="Top" Click="OnClose" ToolTip="Close (Esc)" />
                <StackPanel>
                    <TextBlock Text="{Binding Title}" Foreground="{Binding TitleBrush}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource Muted}" FontSize="12" />
                </StackPanel>
            </DockPanel>

            <!-- Footer -->
            <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0" Visibility="{Binding ResultVisible, Converter={StaticResource BoolToVis}}">
                <Button DockPanel.Dock="Right" Content="Find upgrade" Style="{StaticResource FlatButton}" Click="OnFindUpgrade"
                        ToolTip="Instant Buyout search for a better item for this slot, within your budget" />
                <Button DockPanel.Dock="Right" Content="Open on trade site" Style="{StaticResource FlatButton}" Margin="0,0,6,0" Click="OnOpenUpgrades"
                        Visibility="{Binding HasUpgradeUrl, Converter={StaticResource BoolToVis}}" />
                <Button DockPanel.Dock="Left" Content="Reload character" Style="{StaticResource FlatButton}" Click="OnReload"
                        ToolTip="Fetch your gear again (after you change items)" />
                <TextBlock />
            </DockPanel>

            <StackPanel>
                <TextBlock Text="{Binding Error}" Foreground="#E07A6A" TextWrapping="Wrap" Margin="0,10,0,0"
                           Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />

                <!-- Slot tabs (rings) -->
                <ItemsControl ItemsSource="{Binding Tabs}" Margin="0,8,0,0" Visibility="{Binding HasTabs, Converter={StaticResource BoolToVis}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Label}" Click="OnTab" Margin="0,0,6,0" Padding="10,3">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource FlatButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Selected}" Value="True">
                                                <Setter Property="BorderBrush" Value="{StaticResource Gold}" />
                                                <Setter Property="Foreground" Value="{StaticResource Gold}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Visibility="{Binding ResultVisible, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding CurrentItem}" Foreground="{StaticResource Muted}" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Verdict}" Foreground="{Binding VerdictBrush}" FontSize="16" FontWeight="Bold" TextWrapping="Wrap" Margin="0,4,0,0" />

                    <ItemsControl ItemsSource="{Binding Warnings}" Margin="0,6,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,1">
                                    <TextBlock DockPanel.Dock="Left" Text="⚠" Foreground="#E07A6A" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="#E8B0A6" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Stat rows -->
                    <Grid Margin="0,10,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" /><ColumnDefinition Width="90" /><ColumnDefinition Width="18" /><ColumnDefinition Width="90" /><ColumnDefinition Width="56" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" Text="Now" Foreground="{StaticResource Muted}" FontSize="11" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="3" Text="With this" Foreground="{StaticResource Muted}" FontSize="11" HorizontalAlignment="Right" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Rows}" AlternationCount="2">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="row" Padding="4,2">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" /><ColumnDefinition Width="86" /><ColumnDefinition Width="18" /><ColumnDefinition Width="86" /><ColumnDefinition Width="56" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Label}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Before}" Foreground="{StaticResource Muted}" HorizontalAlignment="Right" />
                                        <TextBlock Grid.Column="2" Text="→" Foreground="{StaticResource Muted}" HorizontalAlignment="Center"
                                                   Visibility="{Binding Arrow, Converter={StaticResource BoolToVis}}" />
                                        <TextBlock Grid.Column="3" Text="{Binding After}" HorizontalAlignment="Right" />
                                        <TextBlock Grid.Column="4" Text="{Binding Delta}" Foreground="{Binding DeltaBrush}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                        <Setter TargetName="row" Property="Background" Value="{StaticResource RowAlt}" />
                                    </Trigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Damage is a relative estimate (life × increased × DoT multi), not a PoB DPS number."
                               Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" />

                    <!-- Find upgrade -->
                    <Border BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,1,0,0" Margin="0,10,0,0" Padding="0,8,0,0">
                        <StackPanel>
                            <TextBlock Text="FIND UPGRADE · INSTANT BUYOUT" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="SemiBold" />
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock Text="Budget" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBox Text="{Binding Budget, UpdateSourceTrigger=PropertyChanged}" Width="46" Margin="0,0,4,0" VerticalContentAlignment="Center" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="cur" Content="div" IsChecked="{Binding BudgetInDivines}" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="cur" Content="c" IsChecked="{Binding BudgetInChaos}" />
                                <TextBlock Text="Prioritise" VerticalAlignment="Center" Margin="10,0,6,0" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="pri" Content="Life" IsChecked="{Binding PrioritiseLife}" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="pri" Content="Damage" IsChecked="{Binding PrioritiseDamage}" />
                            </StackPanel>
                            <TextBlock Text="{Binding UpgradeStatus}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"
                                       Visibility="{Binding HasUpgradeStatus, Converter={StaticResource BoolToVis}}" />
                            <ItemsControl ItemsSource="{Binding UpgradeConstraints}" Margin="0,2,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StringFormat='✓ {0}'}" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0"
                                          Visibility="{Binding HasUpgrades, Converter={StaticResource BoolToVis}}">
                                <ItemsControl ItemsSource="{Binding Upgrades}" AlternationCount="2">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="row" Padding="4,3">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="58" /><ColumnDefinition Width="*" /><ColumnDefinition Width="30" /><ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Price}" Foreground="{StaticResource Gold}" FontWeight="SemiBold" />
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Gains}" Foreground="{Binding GainsBrush}" FontSize="12" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Text="{Binding Age}" Foreground="{StaticResource Muted}" HorizontalAlignment="Right" />
                                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                                                        <Button Content="Trade ↗" Style="{StaticResource FlatButton}" Padding="6,1" FontSize="11" Click="OnOpenListing"
                                                                ToolTip="Open just this listing on the trade site"
                                                                Visibility="{Binding HasUrl, Converter={StaticResource BoolToVis}}" />
                                                        <Button Content="Whisper" Style="{StaticResource FlatButton}" Padding="6,1" FontSize="11" Margin="4,0,0,0" Click="OnCopyWhisper"
                                                                ToolTip="Copy the seller's buy message; paste it in game chat"
                                                                Visibility="{Binding HasWhisper, Converter={StaticResource BoolToVis}}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                                    <Setter TargetName="row" Property="Background" Value="{StaticResource RowAlt}" />
                                                </Trigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
