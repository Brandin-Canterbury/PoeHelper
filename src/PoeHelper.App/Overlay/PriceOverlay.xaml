<Window x:Class="PoeHelper.App.Overlay.PriceOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PoeHelper price check" Width="460" SizeToContent="Height" MaxHeight="760"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False">
    <Window.Resources>
        <ResourceDictionary Source="Theme.xaml" />
    </Window.Resources>
    <Border Background="{StaticResource PanelBg}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="4" Padding="12"
            MouseLeftButtonDown="OnDrag">
        <DockPanel>
            <!-- Header -->
            <DockPanel DockPanel.Dock="Top">
                <Button DockPanel.Dock="Right" Content="✕" Style="{StaticResource FlatButton}" Padding="6,0" VerticalAlignment="Top" Click="OnClose" ToolTip="Close (Esc)" />
                <StackPanel>
                    <TextBlock Text="{Binding Title}" Foreground="{Binding TitleBrush}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource Muted}" FontSize="12" />
                </StackPanel>
            </DockPanel>

            <!-- Footer -->
            <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                <Button DockPanel.Dock="Right" Content="Open on trade site" Style="{StaticResource FlatButton}" Click="OnOpenTrade" />
                <Button DockPanel.Dock="Left" Content="Search again" Style="{StaticResource FlatButton}" Click="OnSearchAgain"
                        Visibility="{Binding HasFilters, Converter={StaticResource BoolToVis}}" ToolTip="Re-run with the ticked stats" />
                <TextBlock />
            </DockPanel>

            <StackPanel>
                <!-- Error -->
                <TextBlock Text="{Binding Error}" Foreground="#E07A6A" TextWrapping="Wrap" Margin="0,10,0,0"
                           Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />

                <!-- Headline -->
                <TextBlock Text="{Binding Headline}" Foreground="{StaticResource Gold}" FontSize="20" FontWeight="Bold" TextWrapping="Wrap" Margin="0,10,0,2"
                           Visibility="{Binding HasError, Converter={StaticResource InverseBoolToVis}}" />
                <StackPanel Orientation="Horizontal" Visibility="{Binding ResultVisible, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding Confidence}" Foreground="{Binding ConfidenceBrush}" FontWeight="SemiBold" />
                    <TextBlock Text="  ·  " Foreground="{StaticResource Muted}" />
                    <TextBlock Text="{Binding Status}" Foreground="{StaticResource Muted}" />
                </StackPanel>

                <!-- Analysis notes -->
                <ItemsControl ItemsSource="{Binding Notes}" Margin="0,8,0,0" Visibility="{Binding ResultVisible, Converter={StaticResource BoolToVis}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,1">
                                <TextBlock DockPanel.Dock="Left" Text="•" Foreground="{StaticResource Accent}" Margin="0,0,6,0" />
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Stat filters (tick to include) -->
                <Expander Header="Search stats" Foreground="{StaticResource Muted}" Margin="0,8,0,0" IsExpanded="True"
                          Visibility="{Binding HasFilters, Converter={StaticResource BoolToVis}}">
                    <ItemsControl ItemsSource="{Binding Filters}" Margin="4,4,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Range}" Foreground="{StaticResource Muted}" Margin="8,0,0,0" />
                                    <CheckBox IsChecked="{Binding Enabled}">
                                        <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                                    </CheckBox>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Expander>

                <!-- Listings -->
                <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0"
                              Visibility="{Binding ResultVisible, Converter={StaticResource BoolToVis}}">
                    <ItemsControl ItemsSource="{Binding Listings}" AlternationCount="2">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="row" Padding="4,2" Opacity="{Binding Opacity}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="72" />
                                            <ColumnDefinition Width="72" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="36" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Price}" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1" Text="{Binding Equivalent}" Foreground="{StaticResource Muted}" />
                                        <TextBlock Grid.Column="2" Text="{Binding Summary}" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Seller}" />
                                        <TextBlock Grid.Column="3" Text="{Binding Age}" Foreground="{StaticResource Muted}" HorizontalAlignment="Right" />
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                        <Setter TargetName="row" Property="Background" Value="{StaticResource RowAlt}" />
                                    </Trigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
