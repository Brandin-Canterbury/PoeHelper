<Window x:Class="PoeHelper.App.SessionHelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="How to get your POESESSID" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="#1A1714" Topmost="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Overlay/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="StepNum" TargetType="Border">
                <Setter Property="Width" Value="22" />
                <Setter Property="Height" Value="22" />
                <Setter Property="CornerRadius" Value="11" />
                <Setter Property="Background" Value="#3A3226" />
                <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Margin" Value="0,0,10,0" />
                <Setter Property="VerticalAlignment" Value="Top" />
            </Style>
            <Style x:Key="Key" TargetType="Border">
                <Setter Property="Background" Value="#2A241C" />
                <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="2" />
                <Setter Property="Padding" Value="4,0" />
                <Setter Property="Margin" Value="2,0" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <StackPanel Margin="20" TextElement.Foreground="{StaticResource Text}" TextElement.FontFamily="Segoe UI">
        <TextBlock Text="Log in with your session cookie" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Gold}" />
        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,4,0,12">
            The POESESSID cookie is how pathofexile.com knows you're logged in. With it, PoeHelper's searches run as you,
            so Find upgrade can use weighted searches. It's optional: everything else works without it.
        </TextBlock>

        <!-- Steps -->
        <DockPanel Margin="0,4">
            <Border Style="{StaticResource StepNum}"><TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" /></Border>
            <TextBlock TextWrapping="Wrap">Open <Hyperlink Click="OnOpenSite" Foreground="{StaticResource Gold}">pathofexile.com</Hyperlink> in your browser and log in with the account you play on.</TextBlock>
        </DockPanel>
        <DockPanel Margin="0,4">
            <Border Style="{StaticResource StepNum}"><TextBlock Text="2" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" /></Border>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Press" VerticalAlignment="Center" />
                <Border Style="{StaticResource Key}"><TextBlock Text="F12" FontFamily="Consolas" /></Border>
                <TextBlock Text="to open the browser's developer tools." VerticalAlignment="Center" />
            </StackPanel>
        </DockPanel>
        <DockPanel Margin="0,4">
            <Border Style="{StaticResource StepNum}"><TextBlock Text="3" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" /></Border>
            <StackPanel>
                <TextBlock Text="Go to the cookies list:" />
                <TextBlock TextWrapping="Wrap" Margin="0,2,0,0">
                    <Run Text="Chrome / Edge:" FontWeight="SemiBold" /> <Run Text="Application" Foreground="{StaticResource Gold}" /> tab →
                    <Run Text="Storage" Foreground="{StaticResource Gold}" /> → <Run Text="Cookies" Foreground="{StaticResource Gold}" /> →
                    <Run Text="https://www.pathofexile.com" FontFamily="Consolas" />
                </TextBlock>
                <TextBlock TextWrapping="Wrap" Margin="0,2,0,0">
                    <Run Text="Firefox:" FontWeight="SemiBold" /> <Run Text="Storage" Foreground="{StaticResource Gold}" /> tab →
                    <Run Text="Cookies" Foreground="{StaticResource Gold}" /> → <Run Text="https://www.pathofexile.com" FontFamily="Consolas" />
                </TextBlock>
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0"
                           Text="If you don't see the tab, click » at the end of the tab row." />
            </StackPanel>
        </DockPanel>
        <DockPanel Margin="0,4">
            <Border Style="{StaticResource StepNum}"><TextBlock Text="4" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" /></Border>
            <TextBlock TextWrapping="Wrap">
                Find the row named <Run Text="POESESSID" FontFamily="Consolas" Foreground="{StaticResource Gold}" />. Double-click its
                <Run Text="Value" FontWeight="SemiBold" /> and copy it (Ctrl+C). It's 32 letters and digits, like
                <Run Text="3f9c0a1b2d4e5f60718293a4b5c6d7e8" FontFamily="Consolas" Foreground="{StaticResource Muted}" />.
            </TextBlock>
        </DockPanel>
        <DockPanel Margin="0,4">
            <Border Style="{StaticResource StepNum}"><TextBlock Text="5" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" /></Border>
            <TextBlock TextWrapping="Wrap">Paste it into PoeHelper's settings, press <Run Text="Test" FontWeight="SemiBold" />, then <Run Text="Save" FontWeight="SemiBold" />.</TextBlock>
        </DockPanel>

        <!-- Safety -->
        <Border Background="#22E07A6A" BorderBrush="#66E07A6A" BorderThickness="1" CornerRadius="3" Padding="12,8" Margin="0,14,0,0">
            <StackPanel>
                <TextBlock Text="Keep it secret" FontWeight="SemiBold" Foreground="#E8B0A6" />
                <TextBlock TextWrapping="Wrap" Margin="0,4,0,0">
                    Anyone with your POESESSID is logged in to pathofexile.com as you, including your account page and trade.
                    Never paste it in Discord, a stream or a screenshot, and only give it to tools you trust.
                </TextBlock>
                <TextBlock TextWrapping="Wrap" Margin="0,6,0,0">
                    <Run Text="To revoke it:" FontWeight="SemiBold" /> log out of pathofexile.com. That ends the session, and PoeHelper's Test will then fail
                    until you paste a new one. Changing your password also ends all sessions.
                </TextBlock>
            </StackPanel>
        </Border>

        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,10,0,0">
            PoeHelper stores it encrypted with Windows (DPAPI) for your Windows user, so it can't be read on another PC
            or by another user. It's only sent to pathofexile.com, never anywhere else, and it isn't written to the log.
        </TextBlock>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Open pathofexile.com" Style="{StaticResource FlatButton}" Margin="0,0,8,0" Click="OnOpenSite" />
            <Button Content="Close" Style="{StaticResource FlatButton}" IsCancel="True" Click="OnClose" />
        </StackPanel>
    </StackPanel>
</Window>
