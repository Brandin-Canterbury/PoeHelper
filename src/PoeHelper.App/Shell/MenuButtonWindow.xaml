<Window x:Class="PoeHelper.App.Shell.MenuButtonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PoeHelper menu"
        WindowStyle="None" ResizeMode="NoResize" SizeToContent="WidthAndHeight"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        AllowsTransparency="True" Background="Transparent">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Overlay/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="MenuRow" TargetType="Button">
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Foreground" Value="{StaticResource Text}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="Transparent" Padding="8,6" CornerRadius="2">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource ControlHover}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
                                    <Setter Property="Cursor" Value="Arrow" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="RowIcon" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="Width" Value="22" />
                <Setter Property="FontFamily" Value="Segoe UI Symbol" />
                <Setter Property="Foreground" Value="{StaticResource Accent}" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Border x:Name="Face" Width="40" Height="40" Cursor="Hand" CornerRadius="3"
                Background="#E61E1A15" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1"
                ToolTip="PoeHelper · hold Alt and drag to move"
                MouseLeftButtonDown="Face_MouseLeftButtonDown" MouseLeftButtonUp="Face_MouseLeftButtonUp"
                MouseEnter="Face_MouseEnter" MouseLeave="Face_MouseLeave">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <Rectangle Width="18" Height="2" Fill="{StaticResource Gold}" />
                <Rectangle Width="18" Height="2" Fill="{StaticResource Gold}" Margin="0,4" />
                <Rectangle Width="18" Height="2" Fill="{StaticResource Gold}" />
            </StackPanel>
        </Border>

        <Popup x:Name="Menu" PlacementTarget="{Binding ElementName=Face}" Placement="Left" HorizontalOffset="-6"
               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" Closed="Menu_Closed">
            <Border Background="{StaticResource PanelBg}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1"
                    CornerRadius="3" Padding="4" MinWidth="220" TextElement.Foreground="{StaticResource Text}">
                <StackPanel>
                    <TextBlock Text="POEHELPER" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="SemiBold" Margin="8,4,8,0" />
                    <TextBlock x:Name="StatusLine" Foreground="{StaticResource Muted}" FontSize="11" Margin="8,0,8,6" TextTrimming="CharacterEllipsis" />
                    <Button Style="{StaticResource MenuRow}" Click="Settings_Click" ToolTip="Account, character, league, hotkeys">
                        <DockPanel><TextBlock Text="⚙" Style="{StaticResource RowIcon}" /><TextBlock Text="Settings" /></DockPanel>
                    </Button>
                    <Button x:Name="ReloadRow" Style="{StaticResource MenuRow}" Click="Reload_Click"
                            ToolTip="Fetch your character's gear and passive tree again (after you change gear)">
                        <DockPanel><TextBlock Text="⟳" Style="{StaticResource RowIcon}" /><TextBlock Text="Reload character" /></DockPanel>
                    </Button>
                    <Button Style="{StaticResource MenuRow}" Click="RefreshData_Click" ToolTip="Re-download trade stat lists (after a patch)">
                        <DockPanel><TextBlock Text="⇩" Style="{StaticResource RowIcon}" /><TextBlock Text="Refresh trade data" /></DockPanel>
                    </Button>
                    <Button Style="{StaticResource MenuRow}" Click="Log_Click" ToolTip="Every checked item's text is logged for bug reports">
                        <DockPanel><TextBlock Text="☰" Style="{StaticResource RowIcon}" /><TextBlock Text="Open log" /></DockPanel>
                    </Button>
                    <Button Style="{StaticResource MenuRow}" Click="ResetPosition_Click" ToolTip="Put this button back in its default spot">
                        <DockPanel><TextBlock Text="⌖" Style="{StaticResource RowIcon}" /><TextBlock Text="Reset button position" /></DockPanel>
                    </Button>
                    <Border Height="1" Background="{StaticResource PanelBorder}" Margin="6,4" />
                    <Button Style="{StaticResource MenuRow}" Click="Quit_Click">
                        <DockPanel><TextBlock Text="✕" Style="{StaticResource RowIcon}" /><TextBlock Text="Quit" /></DockPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
